APP_NAME="PMS Techxaro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=Asia/Karachi
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────
# LOCAL:      root / (no password) / saas_master
# STAGING:    techxaro_staging_app_one / techxaro_staging_app_one / techxaro_staging_admin_one
# PRODUCTION: techxaro_app_one / techxaro_app_one / techxaro_admin_one

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_master
DB_USERNAME=root
DB_PASSWORD=

# Master Database (Super Admin)
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=3306
MASTER_DB_DATABASE=saas_master
MASTER_DB_USERNAME=root
MASTER_DB_PASSWORD=

# Tenant Database Defaults (Individual Orgs → {prefix}{slug})
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=
TENANT_DB_PREFIX=pms_tenant_

# Tenancy
TENANT_MASTER_CONNECTION=mysql_master
TENANT_DOMAIN=pms.test
TENANT_IDENTIFICATION=path

# ─── Application URLs ──────────────────────────────────────────
# LOCAL:      http://localhost:5173
# STAGING:    https://staging.app.one.techxaro.com
# PRODUCTION: https://app.one.techxaro.com

ORG_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5173
API_URL=http://localhost:8000

# ─── Session / Sanctum ─────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=180
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000
SANCTUM_TOKEN_EXPIRATION=1440

# ─── Queue / Cache ─────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ─── Redis ─────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@techxaro.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

# ─── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN_PATTERN=

# ─── Super Admin ───────────────────────────────────────────────
SUPER_ADMIN_TENANT=techxaro

# ─── AWS ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
