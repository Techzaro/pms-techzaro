APP_NAME="PMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=UTC

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────
# Local (XAMPP): DB_HOST=127.0.0.1, DB_USERNAME=root, DB_PASSWORD=
# cPanel:        DB_HOST=localhost,  DB_USERNAME=your_cpanel_user_db, DB_PASSWORD=your_db_password
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pms_techxaro
DB_USERNAME=root
DB_PASSWORD=

# ─── Master Database (SaaS Central) ────────────────────────────────
# Can be same as DB credentials if using one MySQL server
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=3306
MASTER_DB_DATABASE=saas_master
MASTER_DB_USERNAME=root
MASTER_DB_PASSWORD=

# ─── Tenant Database Defaults ──────────────────────────────────────
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=
TENANT_DB_PREFIX=pms_tenant_

# ─── Tenancy ───────────────────────────────────────────────────────
TENANT_MASTER_CONNECTION=mysql_master
# Local:    pms.test
# Production: yourdomain.com
TENANT_DOMAIN=pms.test
TENANT_IDENTIFICATION=subdomain

# ─── Session / Auth ────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local: null | Production: .yourdomain.com
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ─── Broadcasting / Cache / Queue ──────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Mail ───────────────────────────────────────────────────────────
# Local: smtp.gmail.com with app password
# cPanel: smtp.yourdomain.com or external SMTP (Brevo, SendGrid, etc.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=yourdomain.com

# ─── Frontend / Sanctum ───────────────────────────────────────────
# Local:    http://localhost:5173
# cPanel:   https://yourdomain.com
FRONTEND_URL=http://localhost:5173
# Local:    localhost:5173,localhost:8000,127.0.0.1:8000
# cPanel:   yourdomain.com,www.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000
SANCTUM_TOKEN_EXPIRATION=1440

# ─── CORS (leave empty to auto-detect from FRONTEND_URL) ───────────
CORS_ORIGIN_PATTERN=

# ─── Super Admin (tenant slug that sees the admin panel link) ──────
SUPER_ADMIN_TENANT=techxaro

# ─── AWS (optional) ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
