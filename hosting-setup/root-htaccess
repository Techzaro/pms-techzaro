RewriteEngine On

# Handle API requests - proxy to Laravel backend
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ /api/public/index.php?/$1 [L,QSA]

# Handle Sanctum CSRF cookie
RewriteCond %{REQUEST_URI} ^/sanctum/
RewriteRule ^sanctum/(.*)$ /api/public/index.php?/$1 [L,QSA]

# Handle Storage links
RewriteCond %{REQUEST_URI} ^/storage/
RewriteRule ^storage/(.*)$ /api/public/storage/$1 [L]

# Handle frontend - serve index.html for SPA routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
