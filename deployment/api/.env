APP_NAME="PMS Techxaro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.one.techxaro.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=Asia/Karachi
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (Production) ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techxaro_admin_one
DB_USERNAME=techxaro_app_one
DB_PASSWORD=techxaro_app_one

# Master Database (Super Admin)
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=3306
MASTER_DB_DATABASE=techxaro_admin_one
MASTER_DB_USERNAME=techxaro_app_one
MASTER_DB_PASSWORD=techxaro_app_one

# Tenant Database Defaults (Individual Orgs → techxaro_app_one_{slug})
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=techxaro_app_one
TENANT_DB_PASSWORD=techxaro_app_one
TENANT_DB_PREFIX=techxaro_app_one_

# Tenancy
TENANT_MASTER_CONNECTION=mysql_master
TENANT_DOMAIN=app.one.techxaro.com
TENANT_IDENTIFICATION=path

# ─── Application URLs (Production) ──────────────────────────────
ORG_APP_URL=https://app.one.techxaro.com
ADMIN_APP_URL=https://admin.one.techxaro.com
API_URL=https://app.one.techxaro.com

# ─── Session / Sanctum ──────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.one.techxaro.com
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=admin.one.techxaro.com,app.one.techxaro.com
SANCTUM_TOKEN_EXPIRATION=1440

# ─── Queue / Cache ──────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ─── Redis ──────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Mail ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=haroonahmadcrossmediasol@gmail.com
MAIL_PASSWORD=qyifwiguxksghdcn
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@techxaro.com"
MAIL_FROM_NAME="PMS Techxaro"
MAIL_EHLO_DOMAIN=techxaro.com

# ─── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=https://app.one.techxaro.com
FRONTEND_ADMIN_URL=https://admin.one.techxaro.com

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN_PATTERN=

# ─── Super Admin ────────────────────────────────────────────────
SUPER_ADMIN_TENANT=techxaro

# ─── AWS ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
